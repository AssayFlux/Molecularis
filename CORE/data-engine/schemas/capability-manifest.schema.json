{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecularis.org/schemas/msde/capability-manifest-1.schema.json",
  "title": "Molecularis Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "service", "operation", "input_schema", "output_schema"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "service": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "input_schema": {"type": "string", "minLength": 1},
          "output_schema": {"type": "string", "minLength": 1},
          "deterministic": {"type": "boolean", "default": true},
          "description": {"type": "string"}
        }
      }
    }
  }
}
