{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecularis.org/schemas/msde/platform-envelope-1.schema.json",
  "title": "Molecularis Platform Request/Response Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "kind", "payload"],
  "properties": {
    "schema_version": {"const": "1"},
    "request_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["request", "response", "error"]},
    "service_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "payload": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    },
    "provenance": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "error"}}},
      "then": {"required": ["error"]}
    }
  ]
}
