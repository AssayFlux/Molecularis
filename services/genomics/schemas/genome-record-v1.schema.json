{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molecularis.genome-record.v1",
  "title": "Molecularis Genome Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identifier",
    "description",
    "alphabet",
    "contigs"
  ],
  "properties": {
    "schema": {
      "const": "molecularis.genome-record.v1"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "alphabet": {
      "const": "DNA_IUPAC"
    },
    "contigs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "sequence"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500000000,
            "pattern": "^[ACGTRYSWKMBDHVN]+$"
          }
        }
      }
    }
  }
}