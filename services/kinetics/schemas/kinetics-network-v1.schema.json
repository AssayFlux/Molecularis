{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molecularis.kinetics-network.v1",
  "title": "Molecularis Kinetics Network v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identifier",
    "species",
    "initial_concentrations",
    "reactions",
    "time_unit",
    "concentration_unit"
  ],
  "properties": {
    "schema": {
      "const": "molecularis.kinetics-network.v1"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "initial_concentrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "reactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reactants",
          "products",
          "rate_constant"
        ],
        "properties": {
          "reactants": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "products": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "rate_constant": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "time_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "concentration_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  },
  "allOf": [
    {
      "properties": {
        "initial_concentrations": {
          "maxItems": 256
        }
      }
    }
  ]
}
