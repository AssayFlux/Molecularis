{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molecularis.workflow-artifact-reference.v1",
  "title": "Workflow Artifact Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema",
    "media_type",
    "sha256"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": "molecularis.workflow.v1"
    },
    "media_type": {
      "const": "application/vnd.molecularis.workflow+json"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}