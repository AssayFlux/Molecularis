{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molecularis.omics-report.v1",
  "title": "Molecularis Omics Operation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "matrix_id",
    "matrix_sha256",
    "result",
    "rulebook",
    "rules_checked",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "molecularis.omics-report.v1"
    },
    "operation": {
      "enum": [
        "validate",
        "normalize_cpm",
        "clr",
        "differential_welch",
        "differential_nb2",
        "diversity",
        "correlate"
      ]
    },
    "matrix_id": {
      "type": "string"
    },
    "matrix_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "type": "object"
    },
    "rulebook": {
      "const": "omics-core-v1"
    },
    "rules_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
