{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecularis.assayflux.org/schemas/scientific-quantity-v1.schema.json",
  "title": "Molecularis Scientific Quantity v1",
  "type": "object",
  "required": [
    "value",
    "unit",
    "dimension"
  ],
  "properties": {
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "type": "object",
      "required": [
        "powers"
      ],
      "properties": {
        "powers": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "reference_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertainty": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
