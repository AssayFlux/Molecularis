{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecularis.assayflux.org/schemas/scientific-reasoning-v1.schema.json",
  "title": "Molecularis Scientific Reasoning and Construction Contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": [
        "derivation_trace",
        "construction_task",
        "construction_candidate",
        "constraint",
        "objective",
        "solver_diagnostics",
        "optimization_result",
        "graph",
        "vector3",
        "linear_system_result",
        "integration_result",
        "hypothesis_test_result",
        "regression_result",
        "multiple_testing_result",
        "sample_size_result"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "derivation_trace"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "trace_id",
              "steps",
              "method"
            ],
            "properties": {
              "trace_id": {
                "type": "string",
                "minLength": 16
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": "object",
                  "required": [
                    "expression",
                    "variables",
                    "result",
                    "dimension",
                    "assumptions"
                  ],
                  "properties": {
                    "expression": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "variables": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      }
                    },
                    "result": {
                      "type": "number"
                    },
                    "dimension": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "assumptions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "construction_task"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "task_id",
              "domain",
              "mode",
              "objective",
              "assumptions",
              "max_candidates",
              "seed"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "reconstruction",
                  "generalization",
                  "exploration"
                ]
              },
              "objective": {
                "type": "string",
                "minLength": 1
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max_candidates": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "construction_candidate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "candidate_id",
              "domain",
              "representation",
              "assumptions"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "representation": {
                "type": "object"
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "uncertainty": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "graph"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "nodes",
              "edges",
              "directed"
            ],
            "properties": {
              "nodes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "edges": {
                "type": "array",
                "maxItems": 1000000,
                "items": {
                  "type": "object",
                  "required": [
                    "source",
                    "target"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "directed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "vector3"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "x",
              "y",
              "z",
              "unit",
              "coordinate_system"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "coordinate_system": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "linear_system_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "solution",
              "residual_inf_norm",
              "minimum_pivot",
              "converged"
            ],
            "properties": {
              "solution": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              },
              "residual_inf_norm": {
                "type": "number",
                "minimum": 0
              },
              "minimum_pivot": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "converged": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "integration_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "value",
              "estimated_absolute_error",
              "intervals",
              "tolerance",
              "converged"
            ],
            "properties": {
              "value": {
                "type": "number"
              },
              "estimated_absolute_error": {
                "type": "number",
                "minimum": 0
              },
              "intervals": {
                "type": "integer",
                "minimum": 2
              },
              "tolerance": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "converged": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hypothesis_test_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "statistic",
              "degrees_of_freedom",
              "p_value",
              "alternative",
              "sample_sizes",
              "assumptions"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "statistic": {
                "type": "number"
              },
              "degrees_of_freedom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "p_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "alternative": {
                "enum": [
                  "two-sided",
                  "less",
                  "greater"
                ]
              },
              "sample_sizes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer",
                  "minimum": 2
                }
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "regression_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intercept",
              "slope",
              "r_squared",
              "slope_standard_error",
              "slope_ci",
              "slope_p_value",
              "degrees_of_freedom",
              "sample_count",
              "assumptions"
            ],
            "properties": {
              "intercept": {
                "type": "number"
              },
              "slope": {
                "type": "number"
              },
              "r_squared": {
                "type": "number"
              },
              "slope_standard_error": {
                "type": "number",
                "minimum": 0
              },
              "slope_ci": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "slope_p_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "degrees_of_freedom": {
                "type": "integer",
                "minimum": 1
              },
              "sample_count": {
                "type": "integer",
                "minimum": 3
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "multiple_testing_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "adjusted_p_values",
              "rejected",
              "alpha"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "adjusted_p_values": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              },
              "alpha": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "sample_size_result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "per_group",
              "total",
              "alpha",
              "power",
              "standardized_effect",
              "assumptions"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "per_group": {
                "type": "integer",
                "minimum": 2
              },
              "total": {
                "type": "integer",
                "minimum": 4
              },
              "alpha": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "power": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "standardized_effect": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}
