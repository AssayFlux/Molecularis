{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molecularis.pharmacogenomics-sample.v1",
  "title": "Molecularis Pharmacogenomics Synthetic Sample v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identifier", "genome_build", "data_classification", "calls"],
  "properties": {
    "schema": {"const": "molecularis.pharmacogenomics-sample.v1"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "genome_build": {"type": "string", "minLength": 1, "maxLength": 128},
    "data_classification": {"const": "synthetic_non_patient"},
    "calls": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gene_symbol", "haplotype_id", "phase_confirmed", "call_complete", "variants"],
        "properties": {
          "gene_symbol": {"type": "string", "minLength": 1, "maxLength": 128},
          "haplotype_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "phase_confirmed": {"type": "boolean"},
          "call_complete": {"type": "boolean"},
          "variants": {
            "type": "array", "maxItems": 20000,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["genome_build", "chromosome", "position", "reference", "alternate"],
              "properties": {
                "genome_build": {"type": "string", "minLength": 1},
                "chromosome": {"type": "string", "minLength": 1},
                "position": {"type": "integer", "minimum": 1},
                "reference": {"type": "string", "pattern": "^[ACGT]+$"},
                "alternate": {"type": "string", "pattern": "^[ACGT]+$"}
              }
            }
          }
        }
      }
    }
  }
}
