{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "molecularis.pharmacogenomics-definitions.v1",
  "title": "Molecularis Provenance-Pinned Star Allele Definitions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "genome_build", "source", "definitions"],
  "properties": {
    "schema_version": {"const": 1},
    "genome_build": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "release", "url", "license", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"},
        "license": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "definitions": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "gene", "star_allele", "required_variants", "excluded_variants"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "gene": {"type": "string", "minLength": 1},
          "star_allele": {"type": "string", "pattern": "^\\*"},
          "required_variants": {"$ref": "#/$defs/variants"},
          "excluded_variants": {"$ref": "#/$defs/variants"}
        }
      }
    }
  },
  "$defs": {
    "variants": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["chromosome", "position", "ref", "alt"],
        "properties": {
          "chromosome": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 1},
          "ref": {"type": "string", "pattern": "^[ACGT]+$"},
          "alt": {"type": "string", "pattern": "^[ACGT]+$"}
        }
      }
    }
  }
}
