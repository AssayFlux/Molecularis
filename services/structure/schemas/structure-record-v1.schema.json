{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecularis.assayflux.org/schemas/structure-record-v1.schema.json",
  "title": "Molecularis Structure record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identifier",
    "source_format",
    "model_number",
    "coordinate_unit",
    "coordinate_system",
    "atoms"
  ],
  "properties": {
    "schema": {
      "const": "molecularis.structure-record.v1"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_format": {
      "enum": [
        "native",
        "pdb",
        "mmcif"
      ]
    },
    "model_number": {
      "type": "integer",
      "minimum": 1
    },
    "coordinate_unit": {
      "const": "angstrom"
    },
    "coordinate_system": {
      "const": "cartesian_right_handed"
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "serial",
          "name",
          "residue",
          "chain",
          "residue_number",
          "x",
          "y",
          "z",
          "element"
        ],
        "properties": {
          "serial": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "residue": {
            "type": "string",
            "minLength": 1
          },
          "chain": {
            "type": "string"
          },
          "residue_number": {
            "type": "integer"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "element": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
